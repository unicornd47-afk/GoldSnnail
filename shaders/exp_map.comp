#version 450

layout(local_size_x = 256, local_size_y = 1, local_size_z = 1) in;

layout(std430, binding = 0) readonly buffer BasePoints {
    vec4 bases[];
};

layout(std430, binding = 1) readonly buffer Tangents {
    vec4 tangents[];
};

layout(std430, binding = 2) writeonly buffer OutputPoints {
    vec4 results[];
};

layout(push_constant) uniform Params {
    uint count;
    float curvature;
    float lambda_scale;
};

// exp_map: Tangentialraum → Poincaré-Ball
// y = x ⊕ (tanh(√c * λ_x * v) / (√c * ||v||)) * v
vec3 exp_map(vec3 x, vec3 v, float c) {
    float lambda_x = 2.0 / (1.0 - c * dot(x, x));
    float v_norm = length(v);
    
    if (v_norm < 1e-12) return x;
    
    float sqrt_c = sqrt(c);
    float factor = tanh(sqrt_c * lambda_x * v_norm) / (sqrt_c * v_norm);
    
    vec3 y = x + v * factor;
    
    // Projektion zurück in den Ball (numerische Sicherheit)
    float y_norm = length(y);
    if (y_norm >= 1.0) {
        y = y * (0.999999 / y_norm);
    }
    return y;
}

void main() {
    uint idx = gl_GlobalInvocationID.x;
    if (idx >= count) return;
    
    vec3 base = bases[idx].xyz;
    vec3 tangent = tangents[idx].xyz;
    
    vec3 result = exp_map(base, tangent, curvature);
    results[idx] = vec4(result, 0.0);
}
